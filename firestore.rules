rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Curated item bank — readable by authenticated users, never writable
    // from the client. Seeding happens via Admin SDK.
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Parent owns their household subtree.
    match /households/{hid} {
      allow read, write: if request.auth != null
        && resource.data.parentUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.parentUid == request.auth.uid;

      match /{document=**} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/households/$(hid)).data.parentUid == request.auth.uid;
      }
    }
  }
}
