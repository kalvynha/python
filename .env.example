# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Firebase client (safe to expose — they are public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only) — base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT_B64=

# ElevenLabs TTS (server only) — used to generate natural-voice audio
# for spelling prompts. Audio is cached per-text in Firestore after the
# first request. Get a key at https://elevenlabs.io/api.
ELEVENLABS_API_KEY=
