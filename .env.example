# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Firebase client (safe to expose — they are public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only) — base64-encoded service account JSON.
# Also used to authenticate the Google Cloud Text-to-Speech API for
# spelling audio. Make sure the Text-to-Speech API is enabled on the
# GCP project and the service account has roles/cloudtts.user.
FIREBASE_SERVICE_ACCOUNT_B64=
