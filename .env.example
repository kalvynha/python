# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Firebase client (safe to expose — they are public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only) — base64-encoded service account JSON
FIREBASE_SERVICE_ACCOUNT_B64=

# Pixabay API key for spelling_visual image lookups (server only)
# Sign up at https://pixabay.com/api/docs/ for a free key
PIXABAY_API_KEY=
